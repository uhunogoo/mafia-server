  },
  "homepage": "https://github.com/colyseus/create-colyseus#readme",
  "devDependencies": {
    "@colyseus/sdk": "^0.18.2",
    "@colyseus/testing": "^0.18.5",
    "@types/mocha": "^10.0.10",
    "express": "^5.2.1",
    "mocha": "^12.0.2",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@colyseus/auth": "^0.18.2",
    "@colyseus/schema": "^5.0.32",
    "@colyseus/tools": "^0.18.3",
    "colyseus": "^0.18.6"
  }
